   1:Core/Src/bootloader.c **** /*
   2:Core/Src/bootloader.c ****  * bootloader.c
   3:Core/Src/bootloader.c ****  *
   4:Core/Src/bootloader.c ****  *  Created on: Aug 30, 2025
   5:Core/Src/bootloader.c ****  *      Author: abend
   6:Core/Src/bootloader.c ****  *
   7:Core/Src/bootloader.c ****  *
   8:Core/Src/bootloader.c ****  *      Process:
   9:Core/Src/bootloader.c ****  *
  10:Core/Src/bootloader.c ****  *      1.) Click the Reset Button
  11:Core/Src/bootloader.c ****  *      2.) Fetches reads word 0 (32-bit value) at Flash memory (it is BOOT0=0 so the Vector Table 
  12:Core/Src/bootloader.c ****  *      this is the msp (Main Stack Pointer) which points to the top of the stack
  13:Core/Src/bootloader.c ****  *      3.) Then reads the second word (1) which stores the reset handler address, which sets clock
  14:Core/Src/bootloader.c ****  *      to SRAM, zero .bss, etc., then it runs the firmware img we uploaded or have at 0x8008000
  15:Core/Src/bootloader.c ****  *
  16:Core/Src/bootloader.c ****  */
  17:Core/Src/bootloader.c **** 
  18:Core/Src/bootloader.c **** #include <string.h>
  19:Core/Src/bootloader.c **** 
  20:Core/Src/bootloader.c **** #include "bootloader.h"
  21:Core/Src/bootloader.c **** #include "stm32f4xx_hal.h"
  22:Core/Src/bootloader.c **** 
  23:Core/Src/bootloader.c **** #include "usart.h"
  24:Core/Src/bootloader.c **** 
  25:Core/Src/bootloader.c **** extern UART_HandleTypeDef huart2;
  26:Core/Src/bootloader.c **** 
  27:Core/Src/bootloader.c **** static int __io_putchar(int ch)
  28:Core/Src/bootloader.c **** {
  29:Core/Src/bootloader.c ****     uint8_t c = (uint8_t)ch;
  30:Core/Src/bootloader.c ****     HAL_UART_Transmit(&huart2, &c, 1, HAL_MAX_DELAY);
ARM GAS  /tmp/ccEYOayA.s 			page 2


  31:Core/Src/bootloader.c ****     return ch;
  32:Core/Src/bootloader.c **** }
  33:Core/Src/bootloader.c **** 
  34:Core/Src/bootloader.c **** /*
  35:Core/Src/bootloader.c ****  * Erase a contiguous run of sectors.
  36:Core/Src/bootloader.c ****  *
  37:Core/Src/bootloader.c ****  * Do NOT call FLASH_Erase_Sector() directly. It is an internal HAL helper that
  38:Core/Src/bootloader.c ****  * only pokes FLASH_CR (SNB/SER/STRT) and returns immediately. It never waits
  39:Core/Src/bootloader.c ****  * for BSY to clear and never clears SER afterwards. Two consequences:
  40:Core/Src/bootloader.c ****  *
  41:Core/Src/bootloader.c ****  *   1) A second call lands while the first erase is still running. SNB is read
  42:Core/Src/bootloader.c ****  *      continuously by the flash controller, not latched at STRT, so clearing
  43:Core/Src/bootloader.c ****  *      SNB mid-erase retargets the running erase at sector 0 - the bootloader.
  44:Core/Src/bootloader.c ****  *   2) SER is left set, so the next HAL_FLASH_Program() runs with SER and PG
  45:Core/Src/bootloader.c ****  *      both set in FLASH_CR, which the reference manual forbids.
  46:Core/Src/bootloader.c ****  *
  47:Core/Src/bootloader.c ****  * HAL_FLASHEx_Erase() does the full protocol: wait, check flags, clear SER.
  48:Core/Src/bootloader.c ****  */
  49:Core/Src/bootloader.c **** HAL_StatusTypeDef flash_erase_sectors(uint32_t first_sector, uint32_t nb_sectors)
  50:Core/Src/bootloader.c **** {
  51:Core/Src/bootloader.c **** 	FLASH_EraseInitTypeDef erase = {0};
  52:Core/Src/bootloader.c **** 	uint32_t sector_err = 0xFFFFFFFFU;
  53:Core/Src/bootloader.c **** 
  54:Core/Src/bootloader.c **** 	erase.TypeErase    = FLASH_TYPEERASE_SECTORS;
  55:Core/Src/bootloader.c **** 	erase.VoltageRange = FLASH_VOLTAGE_RANGE_3;
  56:Core/Src/bootloader.c **** 	erase.Banks        = FLASH_BANK_1;
  57:Core/Src/bootloader.c **** 	erase.Sector       = first_sector;
  58:Core/Src/bootloader.c **** 	erase.NbSectors    = nb_sectors;
  59:Core/Src/bootloader.c **** 
  60:Core/Src/bootloader.c **** 	HAL_FLASH_Unlock();
  61:Core/Src/bootloader.c **** 
  62:Core/Src/bootloader.c **** 	__HAL_FLASH_CLEAR_FLAG(FLASH_FLAG_EOP    | FLASH_FLAG_OPERR  |
  63:Core/Src/bootloader.c **** 	                       FLASH_FLAG_WRPERR | FLASH_FLAG_PGAERR |
  64:Core/Src/bootloader.c **** 	                       FLASH_FLAG_PGSERR | FLASH_FLAG_PGPERR);
  65:Core/Src/bootloader.c **** 
  66:Core/Src/bootloader.c **** 	HAL_StatusTypeDef status = HAL_FLASHEx_Erase(&erase, &sector_err);
  67:Core/Src/bootloader.c **** 
  68:Core/Src/bootloader.c **** 	HAL_FLASH_Lock();
  69:Core/Src/bootloader.c **** 
  70:Core/Src/bootloader.c **** 	if (status != HAL_OK) {
  71:Core/Src/bootloader.c **** 		printf("erase failed at sector %lu err=0x%08lX\r\n",
  72:Core/Src/bootloader.c **** 		       (unsigned long)sector_err,
  73:Core/Src/bootloader.c **** 		       (unsigned long)HAL_FLASH_GetError());
  74:Core/Src/bootloader.c **** 	}
  75:Core/Src/bootloader.c **** 
  76:Core/Src/bootloader.c **** 	return status;
  77:Core/Src/bootloader.c **** }
  78:Core/Src/bootloader.c **** 
  79:Core/Src/bootloader.c **** /*
  80:Core/Src/bootloader.c ****  * Fetches the first value in the Vector Table, which is the Main Stack Pointer.
  81:Core/Src/bootloader.c ****  * Returns 1 if the MSP is the range of the correct SRAM region
  82:Core/Src/bootloader.c ****  */
  83:Core/Src/bootloader.c **** int IMG_valid(uint32_t addr){
  84:Core/Src/bootloader.c **** 	uint32_t msp = *((volatile uint32_t *) addr);
  85:Core/Src/bootloader.c **** 	printf("0x%08lx\n\r", msp);
  86:Core/Src/bootloader.c **** 	return (msp >= START_SRAM) && (msp <= END_SRAM);
  87:Core/Src/bootloader.c **** }
