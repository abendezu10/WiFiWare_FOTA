  79:Core/Src/st7789.c **** void ST7789_SetRotation(uint8_t m)
  80:Core/Src/st7789.c **** {
  81:Core/Src/st7789.c **** 	ST7789_WriteCommand(ST7789_MADCTL);	// MADCTL
  82:Core/Src/st7789.c **** 	switch (m) {
  83:Core/Src/st7789.c **** 	case 0:
  84:Core/Src/st7789.c **** 		ST7789_WriteSmallData(ST7789_MADCTL_MX | ST7789_MADCTL_MY | ST7789_MADCTL_RGB);
