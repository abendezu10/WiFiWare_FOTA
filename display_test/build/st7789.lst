  28:Core/Src/st7789.c **** /**
  29:Core/Src/st7789.c ****  * @brief Write data to ST7789 controller
  30:Core/Src/st7789.c ****  * @param buff -> pointer of data buffer
  31:Core/Src/st7789.c ****  * @param buff_size -> size of the data buffer
  32:Core/Src/st7789.c ****  * @return none
  33:Core/Src/st7789.c ****  */
  34:Core/Src/st7789.c **** static void ST7789_WriteData(uint8_t *buff, size_t buff_size)
  35:Core/Src/st7789.c **** {
  36:Core/Src/st7789.c **** 	ST7789_Select();
  37:Core/Src/st7789.c **** 	ST7789_DC_Set();
  38:Core/Src/st7789.c **** 
  39:Core/Src/st7789.c **** 	// split data in small chunks because HAL can't send more than 64K at once
  40:Core/Src/st7789.c **** 
  41:Core/Src/st7789.c **** 	while (buff_size > 0) {
  42:Core/Src/st7789.c **** 		uint16_t chunk_size = buff_size > 65535 ? 65535 : buff_size;
  43:Core/Src/st7789.c **** 		#ifdef USE_DMA
  44:Core/Src/st7789.c **** 			if (DMA_MIN_SIZE <= buff_size)
  45:Core/Src/st7789.c **** 			{
  46:Core/Src/st7789.c **** 				HAL_SPI_Transmit_DMA(&ST7789_SPI_PORT, buff, chunk_size);
  47:Core/Src/st7789.c **** 				while (ST7789_SPI_PORT.hdmatx->State != HAL_DMA_STATE_READY)
  48:Core/Src/st7789.c **** 				{}
  49:Core/Src/st7789.c **** 			}
  50:Core/Src/st7789.c **** 			else
  51:Core/Src/st7789.c **** 				HAL_SPI_Transmit(&ST7789_SPI_PORT, buff, chunk_size, HAL_MAX_DELAY);
  52:Core/Src/st7789.c **** 		#else
  53:Core/Src/st7789.c **** 			HAL_SPI_Transmit(&ST7789_SPI_PORT, buff, chunk_size, HAL_MAX_DELAY);
  54:Core/Src/st7789.c **** 		#endif
  55:Core/Src/st7789.c **** 		buff += chunk_size;
  56:Core/Src/st7789.c **** 		buff_size -= chunk_size;
  57:Core/Src/st7789.c **** 	}
  58:Core/Src/st7789.c **** 
  59:Core/Src/st7789.c **** 	ST7789_UnSelect();
  60:Core/Src/st7789.c **** }
